{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@cobbox/project": ["packages/project/src/index.ts"],
      "@cobbox/i18n": ["packages/i18n/src/index.ts"],
      "@cobbox/blocks": ["packages/blocks/src/index.ts"],
      "@cobbox/runtime": ["packages/runtime/src/index.ts"],
      "@cobbox/engine-phaser": ["packages/engine-phaser/src/index.ts"]
    }
  },
  "include": ["apps/editor/src", "apps/editor/*.d.ts", "packages/*/src"]
}
