{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cobble Game",
  "version": "0.13.1",
  "identifier": "studio.cobble.player",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cobble Game",
        "width": 1024,
        "height": 640,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "backgroundColor": "#0d0f12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ]
  }
}
