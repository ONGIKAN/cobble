{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cobble Studio",
  "version": "0.10.0",
  "identifier": "studio.cobble.app",
  "build": {
    "frontendDist": "../../editor/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cobble Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0d0f12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
