{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cobble Studio",
  "version": "0.15.0",
  "identifier": "studio.cobble.app",
  "build": {
    "frontendDist": "../../editor/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cobble Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0d0f12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxNDZDNDdCNzI3RjJGMEIKUldRTEwzOXllOFJHWVJFQmhBS0I2d0hsZitBV21Gdnd1ZDhJMGRBSmRKSTFWTFY2Sm1BWVV0ZFQK",
      "endpoints": [
        "https://ongikan.github.io/cobble/updater.json"
      ]
    }
  }
}
