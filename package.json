{
  "name": "cobbox",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "description": "CobBox - 轻量 2D 积木游戏创作平台",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @cobbox/editor",
    "build": "npm run build:standalone && npm --workspace @cobbox/editor run build",
    "preview": "npm run preview --workspace @cobbox/editor",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node tools/e2e-smoke.mjs",
    "smoke:mobile": "node tools/e2e-mobile.mjs",
    "build:standalone": "node tools/build-standalone.mjs",
    "build:desktop": "node tools/pack-desktop.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3"
  },
  "license": "Apache-2.0"
}
