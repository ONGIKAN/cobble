{
  "name": "cobble",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Cobble Studio - 轻量 2D 积木游戏创作平台",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @cobble/editor",
    "build": "npm run build:standalone && npm --workspace @cobble/editor run build",
    "preview": "npm run preview --workspace @cobble/editor",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node tools/e2e-smoke.mjs",
    "smoke:mobile": "node tools/e2e-mobile.mjs",
    "build:standalone": "node tools/build-standalone.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3"
  },
  "license": "Apache-2.0"
}
